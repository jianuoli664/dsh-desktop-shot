{
  "name": "dsh-desktop-shot",
  "version": "0.4.4",
  "private": true,
  "description": "Host-side screen capture helper for DSH desktop: one composer button minimizes the DSH window and pops up its own frozen-frame region selector; the crop is inserted straight into the composer through the official attachment intake.",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jianuoli664/dsh-desktop-shot.git"
  },
  "homepage": "https://github.com/jianuoli664/dsh-desktop-shot#readme",
  "bugs": {
    "url": "https://github.com/jianuoli664/dsh-desktop-shot/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "screenshot",
    "snip",
    "windows"
  ],
  "license": "MIT"
}
